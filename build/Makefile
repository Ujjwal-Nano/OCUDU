# Build rule for target.
ocudulog_backend_throughput: cmake_check_build_system
	$(MAKE) $(MAKESILENT) -f CMakeFiles/Makefile2 ocudulog_backend_throughput
.PHONY : ocudulog_backend_throughput

# fast build rule for target.
ocudulog_backend_throughput/fast:
	$(MAKE) $(MAKESILENT) -f tests/unittests/ocudulog/CMakeFiles/ocudulog_backend_throughput.dir/build.make tests/unittests/ocudulog/CMakeFiles/ocudulog_backend_throughput.dir/build
.PHONY : ocudulog_backend_throughput/fast

